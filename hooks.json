{
  "trajectory-lens-telemetry": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node hooks/telemetry-hook.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/telemetry-hook.mjs",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node hooks/telemetry-hook.mjs",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/telemetry-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/telemetry-hook.mjs",
        "timeout": 5
      }
    ]
  }
}
